package fixes

import "testing"

func consume(int) {}

func BenchmarkLegacyRange(b *testing.B) {
	for b.Loop() { // want "canonical b.N loop can use"
		consume(1)
	}
}

func BenchmarkLegacyClassic(b *testing.B) {
	for b.Loop() { // want "canonical b.N loop can use"
		consume(1)
	}
}

func BenchmarkNormalizeLoop(b *testing.B) {
	for b.Loop() { // want "B.Loop must be the sole condition"
		consume(1)
	}
}

func BenchmarkRemoveTimerCalls(b *testing.B) {
	// want "duplicates B.Loop behavior"
	for b.Loop() {
		consume(1)
	}
	// want "duplicates B.Loop behavior"
}
